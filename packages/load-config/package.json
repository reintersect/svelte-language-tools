{
    "name": "@reintersect/svelte-load-config",
    "version": "0.2.5",
    "description": "Load Svelte config via vite.config or svelte.config",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reintersect/svelte-language-tools.git",
        "directory": "packages/load-config"
    },
    "main": "dist/src/index.js",
